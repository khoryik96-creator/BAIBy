<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Unity 6 compiles C# 9; keep the shared runtime files within it. -->
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pets keep the shared care records (care slice 7), so the whole simulation assembly is compiled. -->
    <Compile Include="../../unity/Assets/BAIby/Simulation/*.cs" />
    <Compile Include="../../unity/Assets/BAIby/Simulation/Care/*.cs" />
    <Compile Include="../../unity/Assets/BAIby/Simulation/Pets/*.cs" />
    <Compile Include="../../unity/Assets/BAIby/Character/Appearance/*.cs" />
  </ItemGroup>
</Project>
